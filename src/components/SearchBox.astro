---
import { siteInfo } from '../lib/content.js';
---

<div class="header-search" data-search-box>
  <span class="search-icon" aria-hidden="true">🔍</span>
  <input
    class="search-input"
    type="search"
    id="site-search"
    placeholder="搜索鱼类、食谱、兑换码…"
    autocomplete="off"
    aria-label="站内搜索"
    role="combobox"
    aria-expanded="false"
    aria-controls="site-search-results"
  />
  <div class="search-results" id="site-search-results" role="listbox" aria-label="搜索结果" data-search-results></div>
</div>

<script>
  const INDEX_URL = '/search-index.json';
  const MAX_RESULTS = 8;
  let indexPromise = null;

  function loadIndex() {
    if (!indexPromise) {
      indexPromise = fetch(INDEX_URL, { credentials: 'same-origin' })
        .then(function (res) { return res.ok ? res.json() : { items: [] }; })
        .then(function (data) { return Array.isArray(data.items) ? data.items : []; })
        .catch(function () { return []; });
    }
    return indexPromise;
  }

  function score(item, query, terms) {
    const title = (item.title || '').toLowerCase();
    const subtitle = (item.subtitle || '').toLowerCase();
    const keywords = (item.keywords || '').toLowerCase();
    const description = (item.description || '').toLowerCase();
    let total = 0;
    for (const term of terms) {
      if (title === term) total += 60;
      else if (title.startsWith(term)) total += 40;
      else if (title.includes(term)) total += 24;
      if (subtitle.includes(term)) total += 10;
      if (keywords.includes(term)) total += 8;
      if (description.includes(term)) total += 4;
    }
    if (total === 0) return 0;
    if (title.includes(query)) total += 12;
    return total;
  }

  function escapeHtml(value) {
    return String(value == null ? '' : value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function setup(box) {
    if (box.dataset.ready === 'true') return;
    box.dataset.ready = 'true';

    const input = box.querySelector('.search-input');
    const panel = box.querySelector('[data-search-results]');
    if (!input || !panel) return;
    let results = [];
    let activeIndex = -1;

    function close() {
      panel.classList.remove('open');
      input.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
    }

    function render(items, query) {
      results = items;
      activeIndex = -1;
      if (!query) { close(); return; }
      if (!items.length) {
        panel.innerHTML = '<div class="sr-empty">没有找到与「' + escapeHtml(query) + '」相关的内容</div>';
      } else {
        panel.innerHTML = items.map(function (item, i) {
          return '<a href="' + escapeHtml(item.url) + '" role="option" data-index="' + i + '">'
            + '<span class="sr-title">' + escapeHtml(item.title)
            + ' <span class="sr-tag">' + escapeHtml(item.category || '') + '</span></span>'
            + '<span class="sr-sub">' + escapeHtml(item.subtitle || item.description || '') + '</span></a>';
        }).join('') + '<div class="sr-hint">共 ' + items.length + ' 条结果，按 Enter 打开第一条</div>';
      }
      panel.classList.add('open');
      input.setAttribute('aria-expanded', 'true');
    }

    async function search(rawQuery) {
      const query = rawQuery.trim().toLowerCase();
      if (query.length < 1) { close(); return; }
      const items = await loadIndex();
      const terms = query.split(/\s+/).filter(Boolean);
      const scored = [];
      for (const item of items) {
        const value = score(item, query, terms);
        if (value > 0) scored.push({ item: item, value: value });
      }
      scored.sort(function (a, b) { return b.value - a.value; });
      render(scored.slice(0, MAX_RESULTS).map(function (entry) { return entry.item; }), query);
    }

    function move(delta) {
      const links = Array.prototype.slice.call(panel.querySelectorAll('a[role="option"]'));
      if (!links.length) return;
      activeIndex = (activeIndex + delta + links.length) % links.length;
      links.forEach(function (link, i) { link.classList.toggle('active', i === activeIndex); });
      links[activeIndex].scrollIntoView({ block: 'nearest' });
    }

    let timer = null;
    input.addEventListener('input', function () {
      if (timer) clearTimeout(timer);
      const value = input.value;
      timer = setTimeout(function () { search(value); }, 130);
    });

    input.addEventListener('focus', function () {
      if (window.innerWidth < 900) box.classList.add('active');
      if (input.value.trim()) search(input.value);
    });

    input.addEventListener('keydown', function (event) {
      if (event.key === 'ArrowDown') { event.preventDefault(); move(1); }
      else if (event.key === 'ArrowUp') { event.preventDefault(); move(-1); }
      else if (event.key === 'Enter') {
        const links = panel.querySelectorAll('a[role="option"]');
        const target = links[activeIndex >= 0 ? activeIndex : 0];
        if (target) { event.preventDefault(); window.location.href = target.getAttribute('href'); }
      } else if (event.key === 'Escape') {
        input.value = '';
        close();
        box.classList.remove('active');
        input.blur();
      }
    });

    document.addEventListener('click', function (event) {
      if (!box.contains(event.target)) {
        close();
        if (!input.value) box.classList.remove('active');
      }
    });

    const form = box.closest('form');
    if (form) form.addEventListener('submit', function (event) { event.preventDefault(); });
  }

  function boot() {
    document.querySelectorAll('[data-search-box]').forEach(setup);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
  document.addEventListener('astro:page-load', boot);
</script>
