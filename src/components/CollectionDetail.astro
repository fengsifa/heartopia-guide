---
import Breadcrumbs from './Breadcrumbs.astro';
import { formatNumber, href } from '../lib/content.js';
import { englishProse, localizeFacts, localizeList, localizeValue } from '../i18n/data.mjs';
import { dict } from '../i18n/ui.mjs';

// description 由页面传入（与 meta description 同源），保证正文摘要与搜索结果摘要一致
const { collection, item, description, locale } = Astro.props;
const copy = dict(locale);
const collectionCopy = copy.collection;

// 英文页只在数据本身带英文原文时才展示长文，不把中文提示机翻过去
const tips = locale === 'zh'
  ? (item.tips || [])
  : (englishProse(item.tips) ? item.tips : []);
const facts = localizeFacts(locale, item.facts);

const rows = [];
if (localizeValue(locale, item.category)) {
  rows.push({ label: collectionCopy.rowCategory, value: localizeValue(locale, item.category), price: false });
}
if (localizeList(locale, item.location)) {
  rows.push({ label: collectionCopy.rowLocation, value: localizeList(locale, item.location), price: false });
}
if (localizeList(locale, item.time)) {
  rows.push({ label: collectionCopy.rowTime, value: localizeList(locale, item.time), price: false });
}
if (localizeList(locale, item.weather)) {
  rows.push({ label: collectionCopy.rowWeather, value: localizeList(locale, item.weather), price: false });
}
if (item.level) {
  rows.push({ label: collectionCopy.rowLevel, value: item.level, price: false });
}
if (item.price > 0) {
  rows.push({
    label: collectionCopy.rowPrice,
    value: formatNumber(item.price) + ' ' + copy.common.gold,
    price: true
  });
}

const related = (collection.items || []).filter(function (other) {
  if (other.slug === item.slug) return false;
  if (other.category && item.category && other.category === item.category) return true;
  const a = other.location || [];
  const b = item.location || [];
  return a.some(function (entry) { return b.indexOf(entry) !== -1; });
}).slice(0, 6);

const breadcrumbs = [
  { name: copy.common.home, path: '/' },
  { name: collection.name, path: collection.path },
  { name: item.name, path: collection.path + item.slug + '/' }
];

const lede = description || item.description;
---

<Breadcrumbs items={breadcrumbs} locale={locale} />

<div class="detail-layout">
  <div>
    <div class="page-head">
      <h1>{collection.icon} {item.name}</h1>
      <p class="lede">{lede}</p>
    </div>

    {rows.length > 0 && (
      <div class="panel">
        <h2>{collectionCopy.detailInfo}</h2>
        <ul class="stat-list">
          {rows.map(function (row) {
            return (
              <li>
                <span class="k">{row.label}</span>
                <span class={'v' + (row.price ? ' price' : '')}>{row.value}</span>
              </li>
            );
          })}
        </ul>
      </div>
    )}

    {facts.length > 0 && (
      <div class="panel">
        <h2>{collectionCopy.extraInfo}</h2>
        <ul class="stat-list">
          {facts.map(function (fact) {
            return (
              <li>
                <span class="k">{fact.label}</span>
                <span class="v">{fact.value}</span>
              </li>
            );
          })}
        </ul>
      </div>
    )}

    {tips.length > 0 && (
      <div class="panel">
        <h2>{collectionCopy.tips}</h2>
        <ul class="tip-list">
          {tips.map(function (tip) { return <li>{tip}</li>; })}
        </ul>
      </div>
    )}

    {related.length > 0 && (
      <div class="panel">
        <h2>{collectionCopy.related}</h2>
        <div class="grid">
          {related.map(function (other) {
            const meta = other.price > 0
              ? formatNumber(other.price) + ' ' + copy.common.gold
              : (localizeValue(locale, other.category) || copy.common.viewDetails);
            return (
              <a class="card" href={href(locale, collection.path + other.slug + '/')}>
                <span class="card-title">{collection.icon} {other.name}</span>
                <span class="card-text">{meta}</span>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>

  <aside class="side">
    <div class="panel">
      <h2 class="map-panel-title">{collectionCopy.quickFacts}</h2>
      <ul class="stat-list">
        {rows.slice(0, 4).map(function (row) {
          return (
            <li>
              <span class="k">{row.label}</span>
              <span class={'v' + (row.price ? ' price' : '')}>{row.value}</span>
            </li>
          );
        })}
      </ul>
      <p style="margin: 12px 0 0;">
        <a class="btn btn-primary" href={href(locale, collection.path)} style="width: 100%;">{collectionCopy.backTo.replace('{name}', collection.name)}</a>
      </p>
    </div>
  </aside>
</div>
