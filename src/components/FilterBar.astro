---
import { dict } from '../i18n/ui.mjs';

const {
  locale,
  groups = [],
  scope = '',
  placeholder = '',
  label = '',
  total = 0,
  searchLabel = ''
} = Astro.props;

const copy = dict(locale).filter;
const inputPlaceholder = placeholder || copy.placeholder;
const unitLabel = label || copy.unitDefault;
const inputLabel = searchLabel || copy.searchLabel;
---

<div class="filter-bar" data-filter-root data-filter-scope={scope || undefined}>
  <div class="filter-row">
    <input
      class="filter-input"
      type="search"
      data-filter-search
      placeholder={inputPlaceholder}
      aria-label={inputLabel}
      autocomplete="off"
    />
  </div>

  {groups.map(function (group) {
    return (
      <div class="filter-row">
        <span class="filter-label">{group.label}</span>
        <div class="filter-scroll" role="group" aria-label={copy.groupAria.replace('{label}', group.label)}>
          {group.values.map(function (value) {
            return (
              <button
                class="chip"
                type="button"
                data-filter-chip
                data-filter-key={group.key}
                data-filter-value={value}
                aria-pressed="false"
              >{value}</button>
            );
          })}
        </div>
      </div>
    );
  })}

  <div class="filter-status" data-filter-status>
    <span class="filter-count">{copy.count.split('{total}')[0]}<span data-filter-count><strong>{total}</strong></span>{copy.count.split('{total}')[1].replace('{label}', unitLabel)}</span>
    <button class="filter-clear" type="button" data-filter-clear hidden>{copy.clear}</button>
  </div>
</div>

<div class="empty-state" data-filter-empty hidden>
  <p>{copy.empty}</p>
</div>

<script src="/list-filter.js" is:inline></script>
