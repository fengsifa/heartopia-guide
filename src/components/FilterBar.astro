---
const {
  groups = [],
  scope = '',
  placeholder = '搜索…',
  label = '条',
  total = 0,
  searchLabel = '关键词搜索'
} = Astro.props;
---

<div class="filter-bar" data-filter-root data-filter-scope={scope || undefined}>
  <div class="filter-row">
    <input
      class="filter-input"
      type="search"
      data-filter-search
      placeholder={placeholder}
      aria-label={searchLabel}
      autocomplete="off"
    />
  </div>

  {groups.map(function (group) {
    return (
      <div class="filter-row">
        <span class="filter-label">{group.label}</span>
        <div class="filter-scroll" role="group" aria-label={group.label + '筛选'}>
          {group.values.map(function (value) {
            return (
              <button
                class="chip"
                type="button"
                data-filter-chip
                data-filter-key={group.key}
                data-filter-value={value}
                aria-pressed="false"
              >{value}</button>
            );
          })}
        </div>
      </div>
    );
  })}

  <div class="filter-status" data-filter-status>
    <span class="filter-count">共 <span data-filter-count><strong>{total}</strong></span> {label}</span>
    <button class="filter-clear" type="button" data-filter-clear hidden>清除筛选</button>
  </div>
</div>

<div class="empty-state" data-filter-empty hidden>
  <p>没有匹配的条目，试试换个关键词或清除筛选。</p>
</div>

<script src="/list-filter.js" is:inline></script>
