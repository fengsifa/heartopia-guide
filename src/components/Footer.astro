---
import { href, listModules, siteFor } from '../lib/content.js';
import { dict } from '../i18n/ui.mjs';

const { locale } = Astro.props;
const copy = dict(locale);
const siteInfo = siteFor(locale);

const year = new Date().getFullYear();
const modules = listModules(locale);
const half = Math.ceil(modules.length / 2);
const groups = [modules.slice(0, half), modules.slice(half)];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h3>{copy.footer.aboutTitle}</h3>
        <p class="muted">{siteInfo.description}</p>
        <p class="muted tiny">{copy.footer.disclaimer}</p>
      </div>
      {groups.map(function (group, index) {
        return (
          <div>
            <h3>{index === 0 ? copy.footer.guidesTitle : copy.footer.moreTitle}</h3>
            <ul class="footer-links">
              {group.map(function (item) {
                return (
                  <li><a href={href(locale, item.path)}>{item.icon} {item.name}</a></li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </div>
    <p class="footer-note">{copy.footer.note.replace('{year}', year).replace('{site}', siteInfo.name)}</p>
  </div>
</footer>
