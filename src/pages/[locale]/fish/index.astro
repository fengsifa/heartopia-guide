---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FilterBar from '../../../components/FilterBar.astro';
import { fishList, fishFilters, formatNumber, href, moduleMap } from '../../../lib/content.js';
import { itemListLd } from '../../../lib/seo.mjs';
import { LOCALES } from '../../../i18n/config.mjs';
import { dict, t } from '../../../i18n/ui.mjs';
import { localizeList, localizeValue } from '../../../i18n/data.mjs';

export function getStaticPaths() {
  return LOCALES.map(function (locale) {
    return { params: { locale: locale } };
  });
}

const locale = Astro.params.locale;
const copy = dict(locale).fish;
const common = dict(locale).common;
const mod = moduleMap(locale).fish;

const sorted = fishList.slice().sort(function (a, b) { return (b.price || 0) - (a.price || 0); });
const difficulties = Array.from(new Set(fishList.map(function (f) { return f.difficulty; }))).sort();

// 筛选条和卡片上的 data-* 必须用同一种语言，否则英文页的筛选会点不动
const groups = [
  { key: 'location', label: copy.rowLocation, values: fishFilters.locations },
  { key: 'time', label: copy.rowTime, values: fishFilters.times },
  { key: 'weather', label: copy.rowWeather, values: fishFilters.weather },
  { key: 'size', label: copy.rowSize, values: fishFilters.sizes },
  { key: 'difficulty', label: copy.rowDifficulty, values: difficulties }
].map(function (group) {
  return {
    key: group.key,
    label: group.label,
    values: Array.from(new Set(group.values.map(function (value) { return localizeValue(locale, value); })))
  };
}).filter(function (group) { return group.values.length > 0; });

function attr(value) {
  const list = Array.isArray(value) ? value : (value ? [value] : []);
  return list.map(function (entry) { return localizeValue(locale, entry); }).filter(Boolean).join('|');
}

const listPath = href(locale, mod.path);
const breadcrumbs = [{ name: common.home, path: '/' }, { name: mod.name, path: mod.path }];
const site = Astro.site ? Astro.site.href : '';
const description = t(locale, 'fish.description', { count: fishList.length });
const ld = [itemListLd({
  locale: locale,
  site: site,
  path: listPath,
  name: copy.listName,
  description: description,
  entries: sorted.map(function (item) {
    return { name: item.name, path: listPath + item.slug + '/', description: item.description };
  })
})];
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={description}
  breadcrumbs={breadcrumbs}
  webPageType="CollectionPage"
  jsonLd={ld}
>
  <Breadcrumbs items={breadcrumbs} locale={locale} />

  <div class="page-head">
    <h1>{copy.h1}</h1>
    <p class="lede">{t(locale, 'fish.lede', { count: fishList.length })}</p>
  </div>

  <FilterBar
    locale={locale}
    total={sorted.length}
    label={copy.unit}
    placeholder={copy.placeholder}
    searchLabel={copy.searchLabel}
    groups={groups}
  />

  <div class="grid">
    {sorted.map(function (item) {
      const location = localizeList(locale, item.location);
      const time = localizeList(locale, item.time);
      const searchText = [item.name, item.slug, location, time, localizeList(locale, item.weather), localizeValue(locale, item.difficulty)].join(' ');
      return (
        <a
          class="card"
          href={href(locale, '/fish/' + item.slug + '/')}
          data-filter-item
          data-search={searchText}
          data-location={attr(item.location)}
          data-time={attr(item.time)}
          data-weather={attr(item.weather)}
          data-size={attr(item.size)}
          data-difficulty={localizeValue(locale, item.difficulty)}
        >
          <span class="card-title">🐟 {item.name}</span>
          <span class="card-text">
            {copy.rowLocation}{locale === 'zh' ? '：' : ': '}{location || copy.cardUnknown}<br />
            {copy.rowTime}{locale === 'zh' ? '：' : ': '}{time || common.allDay}
          </span>
          <span class="card-foot">
            <span class="badge badge-gold">{item.price ? formatNumber(item.price) + ' ' + common.gold : copy.priceUnknown}</span>
            {item.weather.slice(0, 3).map(function (weather) { return <span class="badge">{localizeValue(locale, weather)}</span>; })}
          </span>
        </a>
      );
    })}
  </div>

  <section class="section">
    <div class="panel">
      <h2 class="mt-0">{copy.mechanicsTitle}</h2>
      <p class="muted">{copy.mechanicsA} {copy.mechanicsB}</p>
      <ul class="tip-list">
        {copy.tips.map(function (tip) { return <li>{tip}</li>; })}
      </ul>
    </div>
  </section>
</BaseLayout>
