---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FilterBar from '../../../components/FilterBar.astro';
import { beginnerList, href, moduleMap } from '../../../lib/content.js';
import { itemListLd } from '../../../lib/seo.mjs';
import { LOCALES } from '../../../i18n/config.mjs';
import { dict, t } from '../../../i18n/ui.mjs';
import { isEnglish, localizeValue, pickText } from '../../../i18n/data.mjs';

export function getStaticPaths() {
  return LOCALES.map(function (locale) {
    return { params: { locale: locale } };
  });
}

const locale = Astro.params.locale;
const copy = dict(locale).beginner;
const common = dict(locale).common;
const mod = moduleMap(locale).beginner;

// 新手指南正文是本站原创中文；补上 titleEn / summaryEn 后英文页自动切换
const items = beginnerList.map(function (item) {
  return Object.assign({}, item, {
    displayTitle: pickText(locale, item.title, item.titleEn),
    displaySummary: isEnglish(item.summaryEn) ? item.summaryEn : '',
    categoryText: localizeValue(locale, item.category),
    readTimeText: localizeValue(locale, item.readTime)
  });
});

const sorted = items.slice().sort(function (a, b) {
  if (a.category === b.category) return 0;
  return a.category === '开局' ? -1 : 1;
});

const categories = Array.from(new Set(sorted.map(function (item) { return item.categoryText; }).filter(Boolean))).sort();
const filterGroups = [{ key: 'category', label: dict(locale).collection.rowCategory, values: categories }]
  .filter(function (group) { return group.values.length > 0; });

function cardText(item) {
  if (item.displaySummary) return item.displaySummary;
  return t(locale, 'beginner.cardFallback', {
    category: item.categoryText,
    readTime: t(locale, 'beginner.readTime', { value: item.readTimeText })
  });
}

const listPath = href(locale, mod.path);
const breadcrumbs = [{ name: common.home, path: '/' }, { name: mod.name, path: mod.path }];
const site = Astro.site ? Astro.site.href : '';
const description = t(locale, 'beginner.description', { count: beginnerList.length });
const ld = [itemListLd({
  locale: locale,
  site: site,
  path: listPath,
  name: copy.listName,
  description: description,
  entries: sorted.map(function (item) {
    return { name: item.displayTitle, path: listPath + item.slug + '/', description: cardText(item) };
  })
})];
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={description}
  breadcrumbs={breadcrumbs}
  webPageType="CollectionPage"
  jsonLd={ld}
>
  <Breadcrumbs items={breadcrumbs} locale={locale} />

  <div class="page-head">
    <h1>{copy.h1}</h1>
    <p class="lede">{t(locale, 'beginner.lede', { count: beginnerList.length })}</p>
  </div>

  <FilterBar
    locale={locale}
    total={sorted.length}
    label={copy.unit}
    placeholder={copy.placeholder}
    searchLabel={copy.searchLabel}
    groups={filterGroups}
  />

  <div class="grid">
    {sorted.map(function (item) {
      const searchText = [item.title, item.titleEn, item.summary, item.summaryEn, item.categoryText]
        .filter(Boolean).join(' ');
      return (
        <a
          class="card"
          href={href(locale, '/beginner/' + item.slug + '/')}
          data-filter-item
          data-search={searchText}
          data-category={item.categoryText}
        >
          <span class="card-title">🧭 {item.displayTitle}</span>
          <span class="card-text">{cardText(item)}</span>
          <span class="card-foot">
            <span class="badge">{item.categoryText}</span>
            <span class="badge">{t(locale, 'beginner.readTime', { value: item.readTimeText })}</span>
          </span>
        </a>
      );
    })}
  </div>

  <section class="section">
    <div class="section-head"><h2>{copy.tocTitle}</h2></div>
    <div class="panel">
      <ul class="stat-list">
        {sorted.map(function (item) {
          return (
            <li>
              <span class="k"><a href={href(locale, '/beginner/' + item.slug + '/')}>{item.displayTitle}</a></span>
              <span class="v tiny muted">{item.categoryText} · {t(locale, 'beginner.readTime', { value: item.readTimeText })}</span>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>
