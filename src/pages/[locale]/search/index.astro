---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { href, listModules, moduleCounts, moduleUnitsFor } from '../../../lib/content.js';
import { LOCALES } from '../../../i18n/config.mjs';
import { dict } from '../../../i18n/ui.mjs';

export function getStaticPaths() {
  return LOCALES.map(function (locale) {
    return { params: { locale: locale } };
  });
}

const locale = Astro.params.locale;
const copy = dict(locale).search;
const common = dict(locale).common;
const units = moduleUnitsFor(locale);

const breadcrumbs = [
  { name: common.home, path: '/' },
  { name: copy.title, path: '/search/' }
];

const sections = listModules(locale).map(function (mod) {
  return { name: mod.name, path: mod.path, count: moduleCounts[mod.id] || 0, unit: units[mod.id] || '' };
});

const countLine = copy.resultsCount.replace('{count}', '<span id="search-page-count"><strong>0</strong></span>');
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <Breadcrumbs items={breadcrumbs} locale={locale} />

  <div class="page-head">
    <h1>{copy.h1}</h1>
    <p class="lede">{copy.lede}</p>
  </div>

  <div class="filter-bar" data-search-page data-index-url={'/search-index.' + locale + '.json'}>
    <div class="filter-row">
      <input
        class="filter-input"
        type="search"
        id="search-page-input"
        placeholder={copy.placeholder}
        aria-label={copy.keywordAria}
        autocomplete="off"
      />
    </div>
    <div class="filter-status">
      <span class="filter-count" set:html={countLine} />
    </div>
  </div>

  <div id="search-page-results" class="grid"></div>
  <div id="search-page-empty" class="empty-state" hidden>
    <p>{copy.empty}</p>
  </div>

  <section class="section">
    <div class="section-head"><h2>{copy.browseTitle}</h2></div>
    <div class="grid">
      {sections.map(function (section) {
        return (
          <a class="card" href={href(locale, section.path)}>
            <span class="card-title">{section.name}</span>
            <span class="card-text">{section.count} {section.unit}</span>
          </a>
        );
      })}
    </div>
  </section>

  <script>
    function escapeHtml(value) {
      return String(value == null ? '' : value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function boot() {
      const root = document.querySelector('[data-search-page]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const input = document.getElementById('search-page-input');
      const results = document.getElementById('search-page-results');
      const empty = document.getElementById('search-page-empty');
      const countEl = document.getElementById('search-page-count');
      if (!input || !results) return;

      const INDEX_URL = root.getAttribute('data-index-url') || '/search-index.en.json';
      function fillCount(count) {
        if (countEl) countEl.innerHTML = '<strong>' + count + '</strong>';
      }

      let indexPromise = null;
      function loadIndex() {
        if (!indexPromise) {
          indexPromise = fetch(INDEX_URL)
            .then(function (res) { return res.ok ? res.json() : { items: [] }; })
            .then(function (data) { return Array.isArray(data.items) ? data.items : []; })
            .catch(function () { return []; });
        }
        return indexPromise;
      }

      async function run(query) {
        const term = query.trim().toLowerCase();
        if (!term) {
          results.innerHTML = '';
          if (empty) empty.hidden = true;
          fillCount(0);
          return;
        }
        const items = await loadIndex();
        const matched = items.filter(function (item) {
          const haystack = [item.title, item.subtitle, item.keywords, item.description, item.category]
            .join(' ').toLowerCase();
          return haystack.indexOf(term) !== -1;
        }).slice(0, 60);

        fillCount(matched.length);
        if (empty) empty.hidden = matched.length !== 0;
        results.innerHTML = matched.map(function (item) {
          return '<a class="card" href="' + escapeHtml(item.url) + '">'
            + '<span class="card-title">' + escapeHtml(item.title) + '</span>'
            + '<span class="card-text">' + escapeHtml(item.subtitle || item.description || '') + '</span>'
            + '<span class="card-foot"><span class="badge">' + escapeHtml(item.category || '') + '</span></span>'
            + '</a>';
        }).join('');
      }

      const params = new URLSearchParams(window.location.search);
      const initial = params.get('q') || '';
      if (initial) input.value = initial;
      run(initial);

      let timer = null;
      input.addEventListener('input', function () {
        if (timer) clearTimeout(timer);
        timer = setTimeout(function () { run(input.value); }, 140);
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('astro:page-load', boot);
  </script>
</BaseLayout>
