---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { mapInfo, href, moduleMap } from '../../../lib/content.js';
import { itemListLd } from '../../../lib/seo.mjs';
import { LOCALES } from '../../../i18n/config.mjs';
import { dict, t } from '../../../i18n/ui.mjs';
import { localizeValue } from '../../../i18n/data.mjs';

export function getStaticPaths() {
  return LOCALES.map(function (locale) {
    return { params: { locale: locale } };
  });
}

const locale = Astro.params.locale;
const copy = dict(locale).map;
const common = dict(locale).common;
const mod = moduleMap(locale).map;

const regionMap = {};
mapInfo.regions.forEach(function (region) { regionMap[region.id] = region; });
const categoryMap = {};
mapInfo.categories.forEach(function (category) { categoryMap[category.id] = category; });

const regions = mapInfo.regions.map(function (region) {
  return Object.assign({}, region, { nameText: localizeValue(locale, region.name) });
});
const categories = mapInfo.categories.map(function (category) {
  return Object.assign({}, category, { nameText: localizeValue(locale, category.name) });
});
const regionNames = {};
regions.forEach(function (region) { regionNames[region.id] = region.nameText; });
const categoryNames = {};
categories.forEach(function (category) { categoryNames[category.id] = category.nameText; });

const markers = mapInfo.markers.map(function (marker) {
  const region = regionMap[marker.region];
  return Object.assign({}, marker, {
    density: region && region.markerCount > 12 ? 'high' : 'normal',
    regionName: regionNames[marker.region] || marker.region,
    regionColor: regionMap[marker.region] ? regionMap[marker.region].color : '#4aa3df',
    categoryName: categoryNames[marker.category] || marker.category,
    categoryIcon: categoryMap[marker.category] ? categoryMap[marker.category].icon : '📍',
    // 地图说明有中英两个字段（由 build-map.mjs 生成），英文页优先用英文原文
    descriptionText: locale === 'zh' ? marker.description : (marker.descriptionEn || localizeValue(locale, marker.description))
  });
});

const breadcrumbs = [{ name: common.home, path: '/' }, { name: mod.name, path: mod.path }];
const categoryCount = {};
markers.forEach(function (marker) { categoryCount[marker.category] = (categoryCount[marker.category] || 0) + 1; });
const breakdown = categories
  .filter(function (category) { return categoryCount[category.id]; })
  .map(function (category) { return t(locale, 'map.breakdown', { name: category.nameText, count: categoryCount[category.id] }); })
  .join(locale === 'zh' ? '、' : ', ');
const regionCount = regions.filter(function (region) { return region.markerCount; }).length;
const description = t(locale, 'map.description', { count: markers.length, regions: regionCount });

const listPath = href(locale, mod.path);
const ld = [itemListLd({
  locale: locale,
  site: Astro.site ? Astro.site.href : '',
  path: listPath,
  name: copy.listName,
  description: description,
  entries: markers.map(function (marker) {
    return { name: marker.name, path: listPath, description: marker.descriptionText };
  }),
  limit: 200
})];

// 地图脚本在浏览器里跑，这些文案通过 data 属性注入
const scriptStrings = {
  regionCount: copy.regionCount,
  selectTitle: copy.selectTitle,
  notSelected: copy.notSelected,
  noNote: copy.noNote,
  markerMeta: copy.markerMeta,
  breakdownNote: breakdown
};
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={description}
  breadcrumbs={breadcrumbs}
  webPageType="CollectionPage"
  jsonLd={ld}
>
  <Breadcrumbs items={breadcrumbs} locale={locale} />

  <div class="page-head">
    <h1>{copy.h1}</h1>
    <p class="lede">{copy.lede}</p>
  </div>

  <div class="map-layout" data-map-root data-map-strings={JSON.stringify(scriptStrings)}>
    <div>
      <div class="filter-bar" style="margin-bottom: 12px;">
        <div class="filter-row">
          <span class="filter-label">{copy.filterCategory}</span>
          <div class="filter-scroll" role="group" aria-label={copy.filterCategoryAria}>
            <button class="chip" type="button" data-map-category="all" aria-pressed="true">{copy.showAll}</button>
            {categories.map(function (category) {
              return (
                <button class="chip" type="button" data-map-category={category.id} aria-pressed="false">
                  {category.icon} {category.nameText}
                </button>
              );
            })}
          </div>
        </div>
        <div class="filter-row">
          <span class="filter-label">{copy.filterRegion}</span>
          <div class="filter-scroll" role="group" aria-label={copy.filterRegionAria}>
            <button class="chip" type="button" data-map-region="all" aria-pressed="true">{copy.showAll}</button>
            {regions.map(function (region) {
              return (
                <button class="chip" type="button" data-map-region={region.id} aria-pressed="false">{region.nameText}</button>
              );
            })}
          </div>
        </div>
        <div class="filter-status">
          <span class="filter-count" set:html={t(locale, 'map.countLine', { count: '<span data-map-count><strong>' + markers.length + '</strong></span>' })} />
          <button class="filter-clear" type="button" data-map-reset hidden>{copy.reset}</button>
        </div>
      </div>

      <div class="map-canvas" role="region" aria-label={copy.canvasAria}>
        <div class="map-layer" aria-hidden="true">
          {regions.map(function (region) {
            const box = region.box;
            return (
              <div
                class="map-region"
                data-map-region-block={region.id}
                style={'left:' + box.x + '%;top:' + box.y + '%;width:' + box.w + '%;height:' + box.h + '%;--region-color:' + region.color + ';'}
              >
                <span class="map-region-name">{region.nameText}</span>
                <span class="map-region-count" data-map-region-count>{t(locale, 'map.regionCount', { count: region.markerCount })}</span>
              </div>
            );
          })}
        </div>
        {markers.map(function (marker) {
          return (
            <button
              class="map-marker"
              type="button"
              style={'left:' + marker.x + '%;top:' + marker.y + '%;border-color:' + marker.regionColor + ';'}
              data-map-marker
              data-id={marker.id}
              data-category={marker.category}
              data-region={marker.region}
              data-density={marker.density}
              aria-pressed="false"
              aria-label={marker.name + ' (' + marker.regionName + ')'}
            >
              <span aria-hidden="true">{marker.categoryIcon}</span>
            </button>
          );
        })}
      </div>

      <div class="map-legend">
        {categories.map(function (category) {
          return <span class="pill">{category.icon} {category.nameText}</span>;
        })}
      </div>

      <p class="tiny muted" style="margin-top: 10px;">{breakdown}</p>
    </div>

    <aside class="side">
      <div class="panel">
        <h2 class="map-panel-title" data-map-title>{copy.selectTitle}</h2>
        <p class="map-detail" data-map-detail>{copy.notSelected}</p>
      </div>

      <div class="panel">
        <h2 class="map-panel-title">{copy.listTitle}</h2>
        <ul class="map-list" data-map-list>
          {markers.map(function (marker) {
            return (
              <li>
                <button
                  type="button"
                  data-map-list-item
                  data-id={marker.id}
                  data-category={marker.category}
                  data-region={marker.region}
                >
                  {marker.categoryIcon} {marker.name}
                  <span class="m-sub">{marker.regionName} · {marker.categoryName}</span>
                </button>
              </li>
            );
          })}
        </ul>
      </div>
    </aside>
  </div>

  <section class="section">
    <div class="section-head">
      <h2>{copy.allTitle}</h2>
      <span class="more">{t(locale, 'map.entryCount', { count: markers.length })}</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">{copy.thName}</th>
            <th scope="col">{copy.thCategory}</th>
            <th scope="col">{copy.thRegion}</th>
            <th scope="col">{copy.thNote}</th>
          </tr>
        </thead>
        <tbody>
          {markers.map(function (marker) {
            return (
              <tr>
                <td class="nowrap">{marker.categoryIcon} {marker.name}</td>
                <td class="nowrap">{marker.categoryName}</td>
                <td class="nowrap">{marker.regionName}</td>
                <td>{marker.descriptionText}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <script is:inline type="application/json" id="map-data" set:html={JSON.stringify(markers)}></script>

  <script>
    function boot() {
      const root = document.querySelector('[data-map-root]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      let strings = {};
      try { strings = JSON.parse(root.getAttribute('data-map-strings') || '{}'); } catch (error) { strings = {}; }
      function text(key, vars) {
        let value = strings[key] || '';
        if (vars) {
          Object.keys(vars).forEach(function (name) {
            value = value.split('{' + name + '}').join(String(vars[name]));
          });
        }
        return value;
      }

      const dataEl = document.getElementById('map-data');
      let data = [];
      try { data = JSON.parse(dataEl ? dataEl.textContent : '[]'); } catch (error) { data = []; }
      const byId = {};
      data.forEach(function (marker) { byId[marker.id] = marker; });

      const markerEls = Array.prototype.slice.call(root.querySelectorAll('[data-map-marker]'));
      const listEls = Array.prototype.slice.call(root.querySelectorAll('[data-map-list-item]'));
      const categoryEls = Array.prototype.slice.call(root.querySelectorAll('[data-map-category]'));
      const regionEls = Array.prototype.slice.call(root.querySelectorAll('[data-map-region]'));
      const regionBlocks = Array.prototype.slice.call(root.querySelectorAll('[data-map-region-block]'));
      const countEl = root.querySelector('[data-map-count]');
      const resetEl = root.querySelector('[data-map-reset]');
      const titleEl = root.querySelector('[data-map-title]');
      const detailEl = root.querySelector('[data-map-detail]');

      let activeCategory = 'all';
      let activeRegion = 'all';
      let activeId = null;

      function isVisible(el) {
        const okCategory = activeCategory === 'all' || el.dataset.category === activeCategory;
        const okRegion = activeRegion === 'all' || el.dataset.region === activeRegion;
        return okCategory && okRegion;
      }

      function applyFilters() {
        let visible = 0;
        const perRegion = {};
        markerEls.forEach(function (el) {
          const show = isVisible(el);
          el.classList.toggle('is-hidden', !show);
          if (show) {
            visible += 1;
            perRegion[el.dataset.region] = (perRegion[el.dataset.region] || 0) + 1;
          }
        });
        regionBlocks.forEach(function (el) {
          const count = perRegion[el.dataset.mapRegionBlock] || 0;
          el.classList.toggle('is-hidden', count === 0);
          const blockCount = el.querySelector('[data-map-region-count]');
          if (blockCount) blockCount.textContent = text('regionCount', { count: count });
        });
        listEls.forEach(function (el) {
          const show = isVisible(el);
          el.closest('li').hidden = !show;
        });
        if (countEl) countEl.innerHTML = '<strong>' + visible + '</strong>';
        if (resetEl) resetEl.hidden = activeCategory === 'all' && activeRegion === 'all';
        if (activeId) {
          const current = markerEls.filter(function (el) { return el.dataset.id === activeId; })[0];
          if (current && current.classList.contains('is-hidden')) clearSelection();
        }
      }

      function clearSelection() {
        activeId = null;
        markerEls.forEach(function (el) { el.setAttribute('aria-pressed', 'false'); });
        listEls.forEach(function (el) { el.removeAttribute('aria-current'); });
        if (titleEl) titleEl.textContent = text('selectTitle');
        if (detailEl) detailEl.textContent = text('notSelected');
      }

      function select(id, scrollIntoView) {
        const marker = byId[id];
        if (!marker) return;
        activeId = id;
        markerEls.forEach(function (el) { el.setAttribute('aria-pressed', el.dataset.id === id ? 'true' : 'false'); });
        listEls.forEach(function (el) {
          if (el.dataset.id === id) {
            el.setAttribute('aria-current', 'true');
            if (scrollIntoView) el.scrollIntoView({ block: 'nearest' });
          } else {
            el.removeAttribute('aria-current');
          }
        });
        if (titleEl) titleEl.textContent = marker.categoryIcon + ' ' + marker.name;
        if (detailEl) {
          detailEl.innerHTML = '';
          const body = document.createElement('span');
          body.textContent = marker.descriptionText || text('noNote');
          const meta = document.createElement('span');
          meta.className = 'tiny';
          meta.style.display = 'block';
          meta.style.marginTop = '8px';
          meta.style.color = '#6f7d96';
          meta.textContent = text('markerMeta', { region: marker.regionName, category: marker.categoryName });
          detailEl.appendChild(body);
          detailEl.appendChild(meta);
        }
      }

      markerEls.forEach(function (el) {
        el.addEventListener('click', function () {
          if (activeId === el.dataset.id) clearSelection();
          else select(el.dataset.id, true);
        });
      });

      listEls.forEach(function (el) {
        el.addEventListener('click', function () { select(el.dataset.id, false); });
      });

      categoryEls.forEach(function (el) {
        el.addEventListener('click', function () {
          activeCategory = el.dataset.mapCategory;
          categoryEls.forEach(function (other) {
            other.setAttribute('aria-pressed', other.dataset.mapCategory === activeCategory ? 'true' : 'false');
          });
          applyFilters();
        });
      });

      regionEls.forEach(function (el) {
        el.addEventListener('click', function () {
          activeRegion = el.dataset.mapRegion;
          regionEls.forEach(function (other) {
            other.setAttribute('aria-pressed', other.dataset.mapRegion === activeRegion ? 'true' : 'false');
          });
          applyFilters();
        });
      });

      if (resetEl) {
        resetEl.addEventListener('click', function () {
          activeCategory = 'all';
          activeRegion = 'all';
          categoryEls.forEach(function (other) {
            other.setAttribute('aria-pressed', other.dataset.mapCategory === 'all' ? 'true' : 'false');
          });
          regionEls.forEach(function (other) {
            other.setAttribute('aria-pressed', other.dataset.mapRegion === 'all' ? 'true' : 'false');
          });
          applyFilters();
        });
      }

      root.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') clearSelection();
      });

      applyFilters();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('astro:page-load', boot);
  </script>
</BaseLayout>
