---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { beginnerList, moduleMeta } from '../../lib/content.js';

export function getStaticPaths() {
  return beginnerList.map(function (item) {
    return { params: { slug: item.slug }, props: { item: item } };
  });
}

const { item } = Astro.props;
const mod = moduleMeta.beginner;

const related = beginnerList.filter(function (other) { return other.slug !== item.slug && other.category === item.category; }).slice(0, 4);
const breadcrumbs = [
  { name: '首页', path: '/' },
  { name: mod.name, path: mod.path },
  { name: item.title, path: '/beginner/' + item.slug + '/' }
];

const description = item.summary;

const ld = [{
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: item.title,
  description: description,
  inLanguage: 'zh-CN',
  step: item.sections.map(function (section, index) {
    return { '@type': 'HowToStep', position: index + 1, name: section.heading, text: section.body };
  })
}];
---

<BaseLayout title={item.title} description={description} breadcrumbs={breadcrumbs} jsonLd={ld}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="detail-layout">
    <div>
      <div class="page-head">
        <h1>🧭 {item.title}</h1>
        <p class="lede">{item.summary}</p>
        <div class="card-foot">
          <span class="badge">{item.category}</span>
          <span class="badge">阅读 {item.readTime}</span>
          <span class="badge">{item.sections.length} 个章节</span>
        </div>
      </div>

      <div class="panel prose">
        {item.sections.map(function (section) {
          return (
            <section>
              <h2>{section.heading}</h2>
              <p class="muted">{section.body}</p>
            </section>
          );
        })}
      </div>

      {item.tips.length > 0 && (
        <div class="panel">
          <h2>重点提示</h2>
          <ul class="tip-list">
            {item.tips.map(function (tip) { return <li>{tip}</li>; })}
          </ul>
        </div>
      )}

      {related.length > 0 && (
        <div class="panel">
          <h2>同分类的其他指南</h2>
          <div class="grid">
            {related.map(function (other) {
              return (
                <a class="card" href={'/beginner/' + other.slug + '/'}>
                  <span class="card-title">🧭 {other.title}</span>
                  <span class="card-text">{other.summary}</span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>

    <aside class="side">
      <div class="panel">
        <h2 class="map-panel-title">本页目录</h2>
        <ul class="tip-list">
          {item.sections.map(function (section) { return <li>{section.heading}</li>; })}
        </ul>
        <p style="margin: 12px 0 0;">
          <a class="btn btn-primary" href="/beginner/" style="width: 100%;">← 返回新手指南</a>
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
