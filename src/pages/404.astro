---
// 静态站服务端不知道访客语言，404 统一用默认语言（英文）
import BaseLayout from '../layouts/BaseLayout.astro';
import { href, listModules } from '../lib/content.js';
import { dict } from '../i18n/ui.mjs';

const locale = 'en';
const copy = dict(locale).notFound;

const modules = listModules(locale);
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  noindex={true}
  canonicalPath="/"
>
  <div class="page-head" style="text-align: center; padding: 40px 0 10px;">
    <h1>{copy.h1}</h1>
    <p class="lede" style="margin-inline: auto;">{copy.lede}</p>
  </div>

  <div class="grid">
    {modules.map(function (mod) {
      return (
        <a class="card module-card" href={href(locale, mod.path)}>
          <span class="card-title"><span class="card-icon" aria-hidden="true">{mod.icon}</span>{mod.name}</span>
          <span class="card-text">{mod.desc}</span>
        </a>
      );
    })}
  </div>

  <p style="text-align: center; margin-top: 22px;">
    <a class="btn btn-primary" href={href(locale, '/')}>{copy.backHome}</a>
  </p>
</BaseLayout>
