---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { farmingList, moduleMeta, formatNumber, profitPerDay, regrowLabel } from '../../lib/content.js';

export function getStaticPaths() {
  return farmingList.map(function (item) {
    return { params: { slug: item.slug }, props: { item: item } };
  });
}

const { item } = Astro.props;
const mod = moduleMeta.farming;

const perDay = profitPerDay(item);
const margin = item.sellPrice ? Math.round(((item.profit || 0) / item.sellPrice) * 100) : 0;
const facts = item.facts || [];

const sameSeason = farmingList
  .filter(function (other) {
    if (other.slug === item.slug) return false;
    if (!other.season || !item.season) return false;
    return other.season === item.season;
  })
  .slice(0, 6);

const breadcrumbs = [
  { name: '首页', path: '/' },
  { name: mod.name, path: mod.path },
  { name: item.name, path: '/farming/' + item.slug + '/' }
];

const description = item.name + ' 是 Heartopia 中的作物，' + item.season + '种植，成熟时间 '
  + item.growthTime + '，种子成本 ' + item.seedCost + ' 金币，售价 ' + item.sellPrice + ' 金币，净利润约 ' + item.profit + ' 金币。';

const ld = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: item.name + ' — Heartopia 种植攻略',
  description: description,
  articleSection: '种植攻略',
  inLanguage: 'zh-CN'
}];
---

<BaseLayout title={item.name + ' 种植收益'} description={description} breadcrumbs={breadcrumbs} jsonLd={ld}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="detail-layout">
    <div>
      <div class="page-head">
        <h1>🌱 {item.name}</h1>
        <p class="lede">{description}</p>
      </div>

      <div class="panel">
        <h2>种植数据</h2>
        <ul class="stat-list">
          <li><span class="k">季节</span><span class="v">{item.season}</span></li>
          <li><span class="k">成熟时间</span><span class="v">{item.growthTime}</span></li>
          <li><span class="k">种子成本</span><span class="v">{formatNumber(item.seedCost)} 金币</span></li>
          <li><span class="k">出售价格</span><span class="v">{formatNumber(item.sellPrice)} 金币</span></li>
          <li><span class="k">单格净赚</span><span class="v price">{formatNumber(item.profit)} 金币</span></li>
          <li><span class="k">理论日收益</span><span class="v">{formatNumber(perDay)} 金币</span></li>
          <li><span class="k">利润率</span><span class="v">{margin}%</span></li>
          <li><span class="k">可复收</span><span class="v">{regrowLabel(item.regrow)}</span></li>
          <li><span class="k">解锁等级</span><span class="v">{item.unlockLevel ? 'Lv.' + item.unlockLevel : '无限制'}</span></li>
        </ul>
      </div>

      {facts.length > 0 && (
        <div class="panel">
          <h2>数据说明</h2>
          <ul class="stat-list">
            {facts.map(function (fact) {
              return <li><span class="k">{fact.label}</span><span class="v">{fact.value}</span></li>;
            })}
          </ul>
        </div>
      )}

      {item.tips.length > 0 && (
        <div class="panel">
          <h2>种植提示</h2>
          <ul class="tip-list">
            {item.tips.map(function (tip) { return <li>{tip}</li>; })}
          </ul>
        </div>
      )}

      {sameSeason.length > 0 && (
        <div class="panel">
          <h2>同季节的其他作物</h2>
          <div class="grid">
            {sameSeason.map(function (other) {
              return (
                <a class="card" href={'/farming/' + other.slug + '/'}>
                  <span class="card-title">🌱 {other.name}</span>
                  <span class="card-text">成熟 {other.growthTime} · 净赚 {formatNumber(other.profit)}</span>
                  <span class="card-foot"><span class="badge">{other.season}</span></span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>

    <aside class="side">
      <div class="panel">
        <h2 class="map-panel-title">收益概览</h2>
        <ul class="stat-list">
          <li><span class="k">净赚</span><span class="v price">{formatNumber(item.profit)}</span></li>
          <li><span class="k">理论日收益</span><span class="v">{formatNumber(perDay)}</span></li>
          <li><span class="k">利润率</span><span class="v">{margin}%</span></li>
        </ul>
        <p style="margin: 12px 0 0;">
          <a class="btn btn-primary" href="/farming/" style="width: 100%;">← 返回种植攻略</a>
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
