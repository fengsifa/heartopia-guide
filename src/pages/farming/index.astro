---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FilterBar from '../../components/FilterBar.astro';
import { farmingList, cropSeasons, moduleMeta, formatNumber, profitPerDay, regrowLabel, uniqueValues } from '../../lib/content.js';

const mod = moduleMeta.farming;

const enriched = farmingList.map(function (item) {
  return Object.assign({}, item, {
    perDay: profitPerDay(item),
    regrowText: regrowLabel(item.regrow)
  });
});

const sorted = enriched.slice().sort(function (a, b) { return b.perDay - a.perDay; });
const cropCategories = uniqueValues(farmingList, 'category');
const groups = [
  { key: 'season', label: '季节', values: cropSeasons },
  { key: 'category', label: '类型', values: cropCategories }
].filter(function (group) { return group.values.length > 0; });

const best = sorted[0];
const breadcrumbs = [{ name: '首页', path: '/' }, { name: mod.name, path: mod.path }];
---

<BaseLayout
  title="Heartopia 种植攻略（收益 / 季节 / 成熟时间）"
  description={'Heartopia 种植攻略与作物收益对比，共 ' + farmingList.length + ' 种作物，含种子成本、成熟时间、净利润与季节安排。'}
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <div class="page-head">
    <h1>🌱 Heartopia 种植攻略</h1>
    <p class="lede">共收录 {farmingList.length} 种作物。按「理论日收益」排序，帮你决定每块地该种什么。数据来自社区 wiki。</p>
  </div>

  {best && (
    <div class="notice" style="margin-bottom: 16px;">
      <span aria-hidden="true">🏆</span>
      <span><strong>当前最高理论日收益：{best.name}</strong> — 成熟 {best.growthTime}，每格净赚 {formatNumber(best.profit)} 金币（约 {formatNumber(best.perDay)} / 天）。</span>
    </div>
  )}

  <FilterBar
    total={sorted.length}
    label="种作物"
    placeholder="搜索作物名…"
    searchLabel="搜索作物"
    groups={groups}
  />

  <div class="grid">
    {sorted.map(function (item) {
      return (
        <a
          class="card"
          href={'/farming/' + item.slug + '/'}
          data-filter-item
          data-search={[item.name, item.season, item.category, item.regrowText].join(' ')}
          data-season={item.season}
          data-category={item.category}
        >
          <span class="card-title">🌱 {item.name}</span>
          <span class="card-text">
            成熟 {item.growthTime} · 种子 {formatNumber(item.seedCost)} 金币<br />
            售价 {formatNumber(item.sellPrice)} 金币 · 净赚 {formatNumber(item.profit)} 金币
          </span>
          <span class="card-foot">
            <span class="badge badge-active">{formatNumber(item.perDay)} / 天</span>
            <span class="badge">{item.season}</span>
            {item.category && <span class="badge">{item.category}</span>}
          </span>
        </a>
      );
    })}
  </div>

  <section class="section">
    <div class="section-head">
      <h2>作物收益一览</h2>
      <span class="more">按每日净收益排序</span>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">作物</th>
            <th scope="col">季节</th>
            <th scope="col">成熟</th>
            <th scope="col" class="num">种子成本</th>
            <th scope="col" class="num">售价</th>
            <th scope="col" class="num">净赚</th>
            <th scope="col" class="num">理论日收益</th>
            <th scope="col">复收</th>
          </tr>
        </thead>
        <tbody>
          {sorted.map(function (item) {
            return (
              <tr>
                <td><a href={'/farming/' + item.slug + '/'}>{item.name}</a></td>
                <td>{item.season}</td>
                <td>{item.growthTime}</td>
                <td class="num">{formatNumber(item.seedCost)}</td>
                <td class="num">{formatNumber(item.sellPrice)}</td>
                <td class="num price">{formatNumber(item.profit)}</td>
                <td class="num">{formatNumber(item.perDay)}</td>
                <td>{item.regrowText}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="panel">
      <h2 class="mt-0">种植要点</h2>
      <ul class="tip-list">
        <li>优先种「理论日收益」高的作物，前期资金有限时不要盲目铺满高价种子。</li>
        <li>wiki 未标注复收信息的作物，先小面积试种再扩大。</li>
        <li>把作物加工成料理往往比直接出售更赚钱，配合烹饪食谱一起规划。</li>
        <li>注意季节限制，换季前把对应作物收完，避免浪费种子成本。</li>
      </ul>
    </div>
  </section>
</BaseLayout>
