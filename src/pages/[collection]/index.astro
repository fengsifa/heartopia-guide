---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CollectionList from '../../components/CollectionList.astro';
import { getCollection, listCollectionIds } from '../../lib/content.js';

export function getStaticPaths() {
  return listCollectionIds().map(function (id) {
    return { params: { collection: id } };
  });
}

const collection = getCollection(Astro.params.collection);
const items = collection.items || [];

const description = 'Heartopia ' + collection.name + '，共收录 ' + items.length + ' ' + collection.unit
  + '，包含' + collection.desc + '，支持筛选与搜索。';

const breadcrumbs = [{ name: '首页', path: '/' }, { name: collection.name, path: collection.path }];

const ld = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Heartopia ' + collection.name,
  description: description,
  numberOfItems: items.length,
  itemListElement: items.slice(0, 60).map(function (item, index) {
    return {
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      description: item.description
    };
  })
}];
---

<BaseLayout
  title={collection.name + '（' + items.length + ' 条）'}
  description={description}
  breadcrumbs={breadcrumbs}
  jsonLd={ld}
>
  <CollectionList collection={collection} />
</BaseLayout>
