---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { moneyList, moduleMeta } from '../../lib/content.js';

export function getStaticPaths() {
  return moneyList.map(function (item) {
    return { params: { slug: item.slug }, props: { item: item } };
  });
}

const { item } = Astro.props;
const mod = moduleMeta.money;

const related = moneyList
  .filter(function (other) { return other.slug !== item.slug && other.difficulty === item.difficulty; })
  .slice(0, 4);

const breadcrumbs = [
  { name: '首页', path: '/' },
  { name: mod.name, path: mod.path },
  { name: item.title, path: '/money/' + item.slug + '/' }
];

const description = item.summary + ' 收益约 ' + item.incomePerHour + '，难度 ' + item.difficulty + '。';

const ld = [{
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: item.title,
  description: description,
  totalTime: item.timeRequired,
  inLanguage: 'zh-CN',
  supply: (item.requirements || []).map(function (req) { return { '@type': 'HowToSupply', name: req }; }),
  step: item.steps.map(function (step, index) {
    return { '@type': 'HowToStep', position: index + 1, text: step };
  })
}];
---

<BaseLayout title={item.title + ' — 赚钱攻略'} description={description} breadcrumbs={breadcrumbs} jsonLd={ld}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="detail-layout">
    <div>
      <div class="page-head">
        <h1>💰 {item.title}</h1>
        <p class="lede">{item.summary}</p>
      </div>

      {item.requirements.length > 0 && (
        <div class="panel">
          <h2>前置条件</h2>
          <div class="pill-list">
            {item.requirements.map(function (req) { return <span class="pill">✓ {req}</span>; })}
          </div>
        </div>
      )}

      <div class="panel">
        <h2>操作步骤</h2>
        <ol class="steps">
          {item.steps.map(function (step) { return <li>{step}</li>; })}
        </ol>
      </div>

      {item.tips.length > 0 && (
        <div class="panel">
          <h2>提升收益的技巧</h2>
          <ul class="tip-list">
            {item.tips.map(function (tip) { return <li>{tip}</li>; })}
          </ul>
        </div>
      )}

      {related.length > 0 && (
        <div class="panel">
          <h2>同难度的其他路线</h2>
          <div class="grid">
            {related.map(function (other) {
              return (
                <a class="card" href={'/money/' + other.slug + '/'}>
                  <span class="card-title">💰 {other.title}</span>
                  <span class="card-text">{other.summary}</span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>

    <aside class="side">
      <div class="panel">
        <h2 class="map-panel-title">收益速览</h2>
        <ul class="stat-list">
          <li><span class="k">预计收益</span><span class="v price">{item.incomePerHour}</span></li>
          <li><span class="k">难度</span><span class="v">{item.difficulty}</span></li>
          <li><span class="k">耗时</span><span class="v">{item.timeRequired}</span></li>
          <li><span class="k">步骤数</span><span class="v">{item.steps.length}</span></li>
        </ul>
        <p style="margin: 12px 0 0;">
          <a class="btn btn-primary" href="/money/" style="width: 100%;">← 返回赚钱攻略</a>
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
