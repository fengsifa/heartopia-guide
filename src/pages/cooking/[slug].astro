---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { recipesList, moduleMeta, formatNumber } from '../../lib/content.js';

export function getStaticPaths() {
  return recipesList.map(function (item) {
    return { params: { slug: item.slug }, props: { item: item } };
  });
}

const { item } = Astro.props;
const mod = moduleMeta.cooking;

const ingredients = item.ingredients || [];
const steps = item.steps || [];
const tips = item.tips || [];
const facts = item.facts || [];

const sameCategory = recipesList
  .filter(function (other) { return other.slug !== item.slug && other.category === item.category; })
  .sort(function (a, b) { return (b.sellPrice || 0) - (a.sellPrice || 0); })
  .slice(0, 6);

const breadcrumbs = [
  { name: '首页', path: '/' },
  { name: mod.name, path: mod.path },
  { name: item.name, path: '/cooking/' + item.slug + '/' }
];

const ingredientNames = ingredients.map(function (ing) {
  return ing.qty ? ing.item + ' ×' + ing.qty : ing.item;
}).join('、');

const description = item.name + ' 是 Heartopia 中的' + item.category + '料理'
  + (ingredientNames ? '，需要 ' + ingredientNames : '')
  + '，出售价约 ' + item.sellPrice + ' 金币。';

const ld = [{
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: item.name,
  description: description,
  recipeCategory: item.category,
  recipeYield: '1 份',
  inLanguage: 'zh-CN',
  recipeIngredient: ingredients.map(function (ing) { return ing.item + (ing.qty ? ' ' + ing.qty + ' 份' : ''); }),
  recipeInstructions: steps.map(function (step) { return { '@type': 'HowToStep', text: step }; })
}];
---

<BaseLayout title={item.name + ' 食谱'} description={description} breadcrumbs={breadcrumbs} jsonLd={ld}>
  <Breadcrumbs items={breadcrumbs} />

  <div class="detail-layout">
    <div>
      <div class="page-head">
        <h1>🍳 {item.name}</h1>
        <p class="lede">{description}</p>
      </div>

      <div class="panel">
        <h2>材料清单</h2>
        {ingredients.length > 0 ? (
          <ul class="stat-list">
            {ingredients.map(function (ing) {
              return (
                <li>
                  <span class="k">{ing.item}</span>
                  <span class="v">{ing.qty ? '× ' + ing.qty : '数量未知'}</span>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="muted" style="margin: 0;">该配方暂未收录具体材料，可在游戏内自行确认。</p>
        )}
      </div>

      {steps.length > 0 && (
        <div class="panel">
          <h2>制作步骤</h2>
          <ol class="steps">
            {steps.map(function (step) { return <li>{step}</li>; })}
          </ol>
        </div>
      )}

      {facts.length > 0 && (
        <div class="panel">
          <h2>配方信息</h2>
          <ul class="stat-list">
            {facts.map(function (fact) {
              return (
                <li>
                  <span class="k">{fact.label}</span>
                  <span class="v">{fact.value}</span>
                </li>
              );
            })}
          </ul>
        </div>
      )}

      {tips.length > 0 && (
        <div class="panel">
          <h2>小贴士</h2>
          <ul class="tip-list">
            {tips.map(function (tip) { return <li>{tip}</li>; })}
          </ul>
        </div>
      )}

      {sameCategory.length > 0 && (
        <div class="panel">
          <h2>同类料理</h2>
          <div class="grid">
            {sameCategory.map(function (other) {
              return (
                <a class="card" href={'/cooking/' + other.slug + '/'}>
                  <span class="card-title">🍳 {other.name}</span>
                  <span class="card-text">{(other.ingredients || []).map(function (ing) { return ing.item; }).join('、') || '材料未公开'}</span>
                  <span class="card-foot"><span class="badge badge-gold">{formatNumber(other.sellPrice)} 金币</span></span>
                </a>
              );
            })}
          </div>
        </div>
      )}
    </div>

    <aside class="side">
      <div class="panel">
        <h2 class="map-panel-title">料理信息</h2>
        <ul class="stat-list">
          <li><span class="k">分类</span><span class="v">{item.category}</span></li>
          <li><span class="k">售价</span><span class="v price">{formatNumber(item.sellPrice)}</span></li>
          <li><span class="k">解锁</span><span class="v">{item.unlock || '未知'}</span></li>
          <li><span class="k">效果</span><span class="v">{item.effect || '无'}</span></li>
        </ul>
        <p style="margin: 12px 0 0;">
          <a class="btn btn-primary" href="/cooking/" style="width: 100%;">← 返回食谱列表</a>
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
