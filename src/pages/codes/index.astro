---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { codesList, moduleMeta } from '../../lib/content.js';

const mod = moduleMeta.codes;
const statusLabel = { active: '可用', limited: '限时', expired: '已过期' };
const order = { active: 0, limited: 1, expired: 2 };
const sorted = codesList.slice().sort(function (a, b) {
  const diff = (order[a.status] || 9) - (order[b.status] || 9);
  if (diff !== 0) return diff;
  return String(b.addedAt || '').localeCompare(String(a.addedAt || ''));
});
const groups = ['active', 'limited', 'expired'].map(function (status) {
  return { status: status, label: statusLabel[status], items: sorted.filter(function (c) { return c.status === status; }) };
}).filter(function (group) { return group.items.length > 0; });

const breadcrumbs = [{ name: '首页', path: '/' }, { name: mod.name, path: mod.path }];
---

<BaseLayout
  title="Heartopia 兑换码（实时更新）"
  description="Heartopia 最新可用兑换码汇总，含奖励内容、状态与过期时间，持续更新中。"
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs items={breadcrumbs} />

  <div class="page-head">
    <h1>🎁 Heartopia 兑换码</h1>
    <p class="lede">共收录 {codesList.length} 个兑换码。兑换码存在过期风险，请在游戏内确认；输入时注意区分大小写。</p>
  </div>

  <div class="notice" style="margin-bottom: 16px;">
    <span aria-hidden="true">💡</span>
    <span>兑换方式：进入游戏 → 设置 → 兑换码，粘贴代码并确认。每个账号同一兑换码通常只能使用一次。</span>
  </div>

  {groups.map(function (group) {
    return (
      <section class="section">
        <div class="section-head">
          <h2>{group.label}兑换码</h2>
          <span class="more">{group.items.length} 个</span>
        </div>
        <div class="grid">
          {group.items.map(function (item) {
            return (
              <article class="card" data-code-item data-search={[item.code, item.reward, item.note].join(' ')}>
                <div class="code-box" style="margin-bottom: 10px;">
                  <span class="code-value">{item.code}</span>
                  <span class={'badge badge-' + item.status}>{statusLabel[item.status]}</span>
                </div>
                <p class="card-text">{item.reward}</p>
                {item.note && <p class="tiny muted" style="margin: 8px 0 0;">{item.note}</p>}
                <div class="card-foot">
                  {item.addedAt && <span class="badge">收录 {item.addedAt}</span>}
                  {item.expiresAt && <span class="badge badge-limited">过期 {item.expiresAt}</span>}
                  {item.verified && <span class="badge badge-active">已验证</span>}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    );
  })}

  <section class="section">
    <div class="panel">
      <h2 class="mt-0">兑换码常见问题</h2>
      <h3>兑换码无效怎么办？</h3>
      <p class="muted">先检查是否有多余空格、大小写是否正确；若仍无效，可能是已过期或该版本尚未生效，可以等待官方活动更新。</p>
      <h3>兑换码多久更新一次？</h3>
      <p class="muted">通常在版本更新、节日活动或社区里程碑时会发放新码，本站会持续跟进。</p>
      <h3>为什么有些码标记为「未验证」？</h3>
      <p class="muted">部分代码来自社区流传，尚未在游戏内确认，因此会标注状态，避免误导。</p>
    </div>
  </section>
</BaseLayout>
